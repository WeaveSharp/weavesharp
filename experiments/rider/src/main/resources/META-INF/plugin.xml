<idea-plugin>
  <id>com.weavesharp.rider.trial</id>
  <name>WeaveSharp Rider Trial</name>
  <vendor>WeaveSharp</vendor>
  <description>Experimental document graph with a native sample edit action.</description>
  <depends>com.intellij.modules.rider</depends>
  <depends>com.intellij.modules.jcef</depends>
  <extensions defaultExtensionNs="com.intellij">
    <fileEditorProvider implementation="com.weavesharp.rider.GraphEditorProvider"/>
  </extensions>
  <actions>
    <action id="WeaveSharp.Rider.InsertSampleStatement"
            class="com.weavesharp.rider.InsertStatementAction"
            text="Insert sample statement"
            description="Insert an empty statement at the selected sample statement">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
