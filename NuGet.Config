<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come only from nuget.org, and every package id is mapped to it, so a
     machine-wide or ambient source can never supply a package (SEC-02). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
