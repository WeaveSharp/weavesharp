{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weavesharp.example/protocol/v0/set-compilation-context.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "envelope.schema.json#/$defs/version"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 23,
      "const": "set-compilation-context"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "enum": [
        "notification"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "languageVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "compilerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "envelope.schema.json#/$defs/namedValue"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "documentUri": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "documentUri",
              "revision"
            ],
            "additionalProperties": false,
            "maxProperties": 2
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "generatedSourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "workspaceId",
        "projectId",
        "contextId",
        "targetId",
        "languageVersion",
        "compilerVersion",
        "options",
        "references",
        "generatedSourceRevision"
      ],
      "additionalProperties": false,
      "maxProperties": 9
    },
    "extensions": {
      "$ref": "envelope.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "version",
    "family",
    "requestId",
    "kind",
    "payload",
    "extensions"
  ],
  "additionalProperties": false,
  "maxProperties": 6
}
