{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weavesharp.example/protocol/v0/initialize.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "envelope.schema.json#/$defs/version"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "const": "initialize"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "enum": [
        "query",
        "response"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "$ref": "envelope.schema.json#/$defs/version"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false,
            "maxProperties": 2
          },
          "minItems": 1,
          "maxItems": 32
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "trustState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "enum": [
            "restricted",
            "trusted"
          ]
        }
      },
      "required": [
        "versions",
        "components",
        "hostId",
        "workspaceId",
        "capabilities",
        "trustState"
      ],
      "additionalProperties": false,
      "maxProperties": 6
    },
    "extensions": {
      "$ref": "envelope.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "version",
    "family",
    "requestId",
    "kind",
    "payload",
    "extensions"
  ],
  "additionalProperties": false,
  "maxProperties": 6
}
