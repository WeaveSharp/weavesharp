{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weavesharp.example/protocol/v0/cancel-or-dispose.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "envelope.schema.json#/$defs/version"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 17,
      "const": "cancel-or-dispose"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "enum": [
        "notification"
      ]
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6,
              "const": "cancel"
            },
            "targetKind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 7,
              "const": "request"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "operation",
            "targetKind",
            "targetId"
          ],
          "additionalProperties": false,
          "maxProperties": 3
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 7,
              "const": "dispose"
            },
            "targetKind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 9,
              "enum": [
                "view",
                "context",
                "session",
                "workspace"
              ]
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "operation",
            "targetKind",
            "targetId"
          ],
          "additionalProperties": false,
          "maxProperties": 3
        }
      ]
    },
    "extensions": {
      "$ref": "envelope.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "version",
    "family",
    "requestId",
    "kind",
    "payload",
    "extensions"
  ],
  "additionalProperties": false,
  "maxProperties": 6
}
